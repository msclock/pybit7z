# 7zip-zstd-codecs-config.cmake
# This config module exposes the directories containing the external codec
# binaries (zstd.dll, brotli.dll, lz4.dll, lz5.dll, lizard.dll, flzma2.dll)
# and the external archive format handler binaries
# (zstdFormat.dll, brotliFormat.dll, lz4Format.dll, lz5Format.dll, lizardFormat.dll).

set(7ZIP_ZSTD_CODECS_DIR "${CMAKE_CURRENT_LIST_DIR}/../../bin/codecs" CACHE PATH "Directory containing 7-Zip-zstd external codec DLLs")
set(7ZIP_ZSTD_FORMATS_DIR "${CMAKE_CURRENT_LIST_DIR}/../../bin/Formats" CACHE PATH "Directory containing 7-Zip-zstd external format handler DLLs")
